    "test": "vitest run"
  },
  "dependencies": {
    "planck": "^1.5.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  }
}

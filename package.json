{
  "name": "marble-race",
  "version": "0.1.0",
  "description": "Carreras de canicas procedurales estilo Algodoo en el navegador",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
